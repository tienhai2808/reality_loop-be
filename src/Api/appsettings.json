{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=reality_loop;Username=admin;Password=__SET_DB_PASSWORD__"
  },
  "SnowflakeId": {
    "GeneratorId": 0
  },
  "Authentication": {
    "Google": {
      "ClientId": "__SET_GOOGLE_CLIENT_ID__",
      "ClientSecret": "__SET_GOOGLE_CLIENT_SECRET__",
      "RedirectUri": "http://localhost:3000/auth/google/callback"
    },
    "Microsoft": {
      "ClientId": "__SET_MICROSOFT_CLIENT_ID__",
      "ClientSecret": "__SET_MICROSOFT_CLIENT_SECRET__",
      "TenantId": "common",
      "RedirectUri": "http://localhost:3000/auth/microsoft/callback"
    },
    "Facebook": {
      "AppId": "__SET_FACEBOOK_APP_ID__",
      "AppSecret": "__SET_FACEBOOK_APP_SECRET__",
      "RedirectUri": "http://localhost:3000/auth/facebook/callback",
      "GraphApiVersion": "v26.0"
    },
    "Jwt": {
      "Issuer": "RealityLoop",
      "Audience": "RealityLoop.Api",
      "SigningKey": "__SET_RANDOM_SIGNING_KEY_AT_LEAST_32_BYTES__",
      "AccessTokenLifetimeMinutes": 15
    },
    "Session": {
      "RefreshTokenLifetimeDays": 7,
      "AbsoluteLifetimeDays": 30
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
