{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=reality_loop;Username=admin;Password=__SET_DB_PASSWORD__"
  },
  "SnowflakeId": {
    "GeneratorId": 0
  },
  "AI": {
    "KeyProtection": {
      "ActiveKeyId": "primary",
      "Keys": {
        "primary": "__SET_BASE64_32_BYTE_AI_ENCRYPTION_KEY__"
      },
      "FingerprintKey": "__SET_SEPARATE_BASE64_32_BYTE_AI_FINGERPRINT_KEY__"
    },
    "Providers": {
      "OpenAiFallbackModels": [],
      "AnthropicFallbackModels": [],
      "GoogleFallbackModels": []
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "__SET_GOOGLE_CLIENT_ID__",
      "ClientSecret": "__SET_GOOGLE_CLIENT_SECRET__",
      "RedirectUri": "https://my-client.tienhai.click/auth/google/callback"
    },
    "Microsoft": {
      "ClientId": "__SET_MICROSOFT_CLIENT_ID__",
      "ClientSecret": "__SET_MICROSOFT_CLIENT_SECRET__",
      "TenantId": "common",
      "RedirectUri": "https://my-client.tienhai.click/auth/microsoft/callback"
    },
    "Facebook": {
      "AppId": "__SET_FACEBOOK_APP_ID__",
      "AppSecret": "__SET_FACEBOOK_APP_SECRET__",
      "RedirectUri": "https://my-client.tienhai.click/auth/facebook/callback",
      "GraphApiVersion": "v26.0"
    },
    "Jwt": {
      "Issuer": "RealityLoop",
      "Audience": "RealityLoop.Api",
      "SigningKey": "__SET_RANDOM_SIGNING_KEY_AT_LEAST_32_BYTES__",
      "AccessTokenLifetimeMinutes": 15
    },
    "Session": {
      "RefreshTokenLifetimeDays": 7,
      "AbsoluteLifetimeDays": 30
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "https://my-client.tienhai.click"
    ]
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "LearningProfiles": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "AiSetup": {
      "IpPermitLimit": 120,
      "UserPermitLimit": 60,
      "WindowSeconds": 60,
      "ConcurrentRequestsPerUser": 2
    },
    "Authentication": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  }
}
