@baseUrl = http://localhost:5285/api/v1
@accessToken = REPLACE_AFTER_LOGIN
@refreshToken = REPLACE_AFTER_LOGIN
@aiConnectionId = REPLACE_AI_CONNECTION_ID
@aiConnectionVersion = 1
@languageCode = ja
@writingSystemCode = hiragana
@writingItemCode = kana-r0-c0
@contentLocale = vi
@pronunciationRuleCode = dakuten-handakuten
@learningProfileId = REPLACE_LEARNING_PROFILE_ID
@learningProfileVersion = 1
@aiRequestId = 11111111-1111-4111-8111-111111111111

### Supported AI providers
GET {{baseUrl}}/ai/providers
Authorization: Bearer {{accessToken}}

### Discover models using a key (not persisted at this step)
POST {{baseUrl}}/ai/providers/OpenAI/models
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "apiKey": "REPLACE_PROVIDER_API_KEY" }

### Connect one model. Use a new UUID for a new connection; reuse it only to retry this same request.
POST {{baseUrl}}/ai/connections
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{aiRequestId}}
Content-Type: application/json

{ "provider": "OpenAI", "apiKey": "REPLACE_PROVIDER_API_KEY", "modelId": "REPLACE_MODEL_FROM_CATALOG", "displayName": "My AI" }

### List AI connections; use nextCursor as after to load the next page
GET {{baseUrl}}/ai/connections?pageSize=20
Authorization: Bearer {{accessToken}}

### Update settings. Use the latest version returned by list/update/verify.
PATCH {{baseUrl}}/ai/connections/{{aiConnectionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "version": {{aiConnectionVersion}}, "isEnabled": false }

### Verify stored key/model (may consume a small amount of provider tokens)
POST {{baseUrl}}/ai/connections/{{aiConnectionId}}/verify
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "version": {{aiConnectionVersion}} }

### Delete the connection from the application
DELETE {{baseUrl}}/ai/connections/{{aiConnectionId}}?version={{aiConnectionVersion}}
Authorization: Bearer {{accessToken}}

### Start Google login: fetch with credentials or navigate to /auth/google in a browser.
GET {{baseUrl}}/auth/google/authorize

### Start Microsoft login: fetch with credentials or navigate to /auth/microsoft in a browser.
GET {{baseUrl}}/auth/microsoft/authorize

### Microsoft frontend callback. Use the code/state from Microsoft and the same browser's correlation cookie.
POST {{baseUrl}}/auth/microsoft/callback
Content-Type: application/json

{ "code": "REPLACE_MICROSOFT_CODE", "state": "REPLACE_LOGIN_STATE", "device": { "deviceType": "Desktop", "deviceName": "Web" } }

### Start Facebook login: fetch with credentials or navigate to /auth/facebook in a browser.
GET {{baseUrl}}/auth/facebook/authorize

### Facebook frontend callback. Use the code/state from Facebook and the same browser's correlation cookie.
POST {{baseUrl}}/auth/facebook/callback
Content-Type: application/json

{ "code": "REPLACE_FACEBOOK_CODE", "state": "REPLACE_LOGIN_STATE", "device": { "deviceType": "Desktop", "deviceName": "Web" } }

### Current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Rotate refresh token; replace BOTH tokens with the returned values.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Revoke by refresh token (works with an expired access token)
POST {{baseUrl}}/auth/revoke
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Logout current session
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

### Active sessions (keyset pagination)
GET {{baseUrl}}/auth/sessions?pageSize=20
Authorization: Bearer {{accessToken}}

### Logout selected devices; use IDs from the session list
POST {{baseUrl}}/auth/logout/sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "sessionIds": ["REPLACE_SESSION_ID"] }

### Logout every other session
POST {{baseUrl}}/auth/logout/others
Authorization: Bearer {{accessToken}}

### Logout every session, including the current one
POST {{baseUrl}}/auth/logout/all
Authorization: Bearer {{accessToken}}


### Learning profile options (self-assessed proficiency and goals)
GET {{baseUrl}}/learning-profiles/options
Authorization: Bearer {{accessToken}}

### Create a profile; this does not change the current selection
POST {{baseUrl}}/learning-profiles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "targetLanguage": "ja",
  "nativeLanguage": "vi",
  "explanationLanguage": "vi",
  "proficiencyLevel": "Beginner",
  "primaryGoal": "Travel",
  "goalNote": "Practice speaking while travelling"
}

### List profiles; use nextCursor as after for the next page
GET {{baseUrl}}/learning-profiles?pageSize=20
Authorization: Bearer {{accessToken}}

### Get one owned profile
GET {{baseUrl}}/learning-profiles/{{learningProfileId}}
Authorization: Bearer {{accessToken}}

### Replace all preferences using the latest version; null clears goalNote
PUT {{baseUrl}}/learning-profiles/{{learningProfileId}}/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "version": {{learningProfileVersion}},
  "nativeLanguage": "vi",
  "explanationLanguage": "en-us",
  "proficiencyLevel": "Elementary",
  "primaryGoal": "DailyLife",
  "goalNote": null
}

### Current learning profile; returns 204 if no profile is selected
GET {{baseUrl}}/learning-profiles/current
Authorization: Bearer {{accessToken}}

### Select an owned profile without modifying its preferences/version
PUT {{baseUrl}}/learning-profiles/current
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "profileId": "{{learningProfileId}}" }

### Delete using the latest version; deleting current also clears the selection
DELETE {{baseUrl}}/learning-profiles/{{learningProfileId}}?version={{learningProfileVersion}}
Authorization: Bearer {{accessToken}}


### Language catalog: enabled languages only; use nextCursor as after
GET {{baseUrl}}/languages?locale={{contentLocale}}&pageSize=20
Authorization: Bearer {{accessToken}}

### Localized language details (not found/disabled returns 404)
GET {{baseUrl}}/languages/{{languageCode}}?locale={{contentLocale}}
Authorization: Bearer {{accessToken}}

### Published writing systems for this enabled language
GET {{baseUrl}}/languages/{{languageCode}}/writing-systems?locale={{contentLocale}}&pageSize=20
Authorization: Bearer {{accessToken}}

### Writing system introduction (list already contains this metadata)
GET {{baseUrl}}/languages/{{languageCode}}/writing-systems/{{writingSystemCode}}?locale={{contentLocale}}
Authorization: Bearer {{accessToken}}

### Character chart with first reading per item; no per-cell requests needed
GET {{baseUrl}}/languages/{{languageCode}}/writing-systems/{{writingSystemCode}}/items?pageSize=100
Authorization: Bearer {{accessToken}}

### All readings for the selected item, paginated; audioUrl may be null
GET {{baseUrl}}/languages/{{languageCode}}/writing-systems/{{writingSystemCode}}/items/{{writingItemCode}}/readings?pageSize=20
Authorization: Bearer {{accessToken}}


### Published pronunciation rules: localized menu summaries, without full explanations/examples
GET {{baseUrl}}/languages/{{languageCode}}/pronunciation-rules?locale={{contentLocale}}&pageSize=20
Authorization: Bearer {{accessToken}}

### Full explanation and usage note for the selected rule
GET {{baseUrl}}/languages/{{languageCode}}/pronunciation-rules/{{pronunciationRuleCode}}?locale={{contentLocale}}
Authorization: Bearer {{accessToken}}

### Examples for the selected published rule; audioUrl may be null
GET {{baseUrl}}/languages/{{languageCode}}/pronunciation-rules/{{pronunciationRuleCode}}/examples?pageSize=20
Authorization: Bearer {{accessToken}}
